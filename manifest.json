{
  "manifest_version": 3,
  "name": "Custom New Tab",
  "version": "1.0",
  "description": "Custom new tab with background, clock, calendar, and todo list",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon128.svg",
    "48": "icons/icon128.svg",
    "128": "icons/icon128.svg"
  },
  "permissions": [
    "storage"
  ]
}
